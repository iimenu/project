<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ii.Reborn</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <TargetFramework>netstandard2.1</TargetFramework>
	  <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(II_GAMEDIR)' != ''">$(II_GAMEDIR)</GameDir>
    <SteamInstall Condition="'$(SteamInstall)' == ''">$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Valve\Steam@InstallPath)</SteamInstall>
    <GameDir Condition="'$(GameDir)' == '' and Exists('$(SteamInstall)\steamapps\common\Gorilla Tag')">$(SteamInstall)\steamapps\common\Gorilla Tag</GameDir>
    <GameRefs Condition="'$(GameRefs)' == '' and '$(GameDir)' != '' and Exists('$(GameDir)\Gorilla Tag_Data\Managed')">$(GameDir)\Gorilla Tag_Data\Managed</GameRefs>
    <CoreRefs Condition="'$(CoreRefs)' == '' and '$(GameDir)' != '' and Exists('$(GameDir)\BepInEx\core')">$(GameDir)\BepInEx\core</CoreRefs>
    <GameRefs Condition="'$(GameRefs)' == '' and Exists('$(MSBuildProjectDirectory)\References\Managed')">$(MSBuildProjectDirectory)\References\Managed</GameRefs>
    <CoreRefs Condition="'$(CoreRefs)' == '' and Exists('$(MSBuildProjectDirectory)\References\core')">$(MSBuildProjectDirectory)\References\core</CoreRefs>
  </PropertyGroup>

  <Target Name="RequireGameRefs" BeforeTargets="BeforeBuild">
    <Error Condition="'$(GameRefs)' == '' or !Exists('$(GameRefs)')" Text="game refs not found. set GameDir to your Gorilla Tag install root via Directory.Build.props (gitignored), II_GAMEDIR env var, or -p:GameDir=..." />
    <Error Condition="'$(CoreRefs)' == '' or !Exists('$(CoreRefs)')" Text="bepinex refs not found. set GameDir to your Gorilla Tag install root via Directory.Build.props (gitignored), II_GAMEDIR env var, or -p:GameDir=..." />
  </Target>

  <PropertyGroup> 
    <StartAction>Program</StartAction>
    <StartProgram>C:\Windows\explorer.exe</StartProgram>
    <StartArguments>steam://run/1533390</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="LICENSE" />
    <None Remove="Resources\Client\*" />
    <Compile Remove="IiServersShim.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Client\*" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>
  
  <PropertyGroup>
    <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
  </PropertyGroup>
	
